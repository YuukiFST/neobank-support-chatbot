# LLM Provider: "ollama", "groq", or "gemini"
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# Custom path for LLM models (stored in /mnt/Others/LLMs)
LLM_MODELS_PATH=/mnt/Others/LLMs

# Groq (free tier)
GROQ_API_KEY=

# Gemini (free tier)
GEMINI_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://neobank:neobank_secret@localhost:5432/neobank

# Redis
REDIS_URL=redis://localhost:6379/0

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Mock API fault injection (0.0 - 1.0)
FAULT_RATE=0.0

# Security (leave API_KEY empty for local dev without auth)
API_KEY=
ENVIRONMENT=dev
RATE_LIMIT_PER_MINUTE=30

# Logging
LOG_LEVEL=INFO
